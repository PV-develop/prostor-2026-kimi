---
import SectionLabel from '../ui/SectionLabel.astro';
import Button from '../ui/Button.astro';
import TeamCard from '../ui/TeamCard.astro';
import { team } from '../../content/home';
---

<section class="team" id="reviews" aria-label="Команда и отзывы">
  <SectionLabel text={team.label} variant="h" tone="light" class="team__label" />
  <div class="team__head" data-reveal data-m="sechead">
    <h2 class="team__title">
      <span class="team__title-line">Кто ведёт</span><br />
      <span class="team__title-line team__title-indent">ваш проект</span>
    </h2>
    <!-- TODO: страницы всей команды пока нет — ссылка ведёт к форме; вернуть href при создании страницы -->
    <Button href="#contacts" label="Вся команда" variant="outline-light" arrow="arrow" class="team__all" />
  </div>
  <div class="team__grid" data-m="team">
    {team.members.map((member, i) => (
      <TeamCard {...member} num={`0${i + 1}`} />
    ))}
  </div>
</section>

<style>
  .team {
    background: var(--color-bg-dark);
    color: var(--color-text-primary-inverse);
    padding: var(--space-section-y) 0 100px;
    overflow: hidden;
  }
:global(.team__label) {
    margin: 0 var(--space-page) 40px;
  }
  .team__head {
    padding: 0 var(--space-page);
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3xl);
  }
  .team__title {
    margin: 0;
    font: 700 var(--fs-h2) / var(--lh-display-2) var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    flex: 1;
    min-width: 0;
  }
  .team__title-line {
    white-space: nowrap;
  }
  .team__title-indent {
    padding-left: 0.6em;
  }
:global(.team__all) {
    margin-bottom: 12px;
    padding: 24px 28px;
  }
  .team__grid {
    margin-top: 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
    padding: 0 var(--space-page);
    align-items: stretch;
  }
  @media (max-width: 768px) {
    .team {
      padding: 88px 0 72px;
    }
    .team__label {
      margin: 0 var(--space-page-mobile) 40px;
    }
    .team__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding: 0 var(--space-page-mobile);
    }
    .team__all {
      margin-bottom: 0;
    }
    .team__grid {
      margin-top: 48px;
      padding: 0 var(--space-page-mobile);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-md);
    }
  }
</style>
