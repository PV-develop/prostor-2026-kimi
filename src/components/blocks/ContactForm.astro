---
import TextField from '../ui/TextField.astro';
import TextArea from '../ui/TextArea.astro';
import FileField from '../ui/FileField.astro';
---

<form class="contact-form" data-mock-form>
  <div class="contact-form__head">
    <h2 class="contact-form__title">
      Оставьте заявку, чтобы <span class="contact-form__accent">обсудить проект</span>
    </h2>
    <p class="contact-form__lead">Свяжемся в течение часа и проконсультируем по вашему вопросу.</p>
  </div>
  <div class="contact-form__fields">
    <TextField name="name" label="Имя" tone="dark" autocomplete="name" class="contact-form__wide" />
    <TextField name="email" label="Почта" type="email" tone="dark" autocomplete="email" />
    <TextField name="phone" label="Телефон" type="tel" tone="dark" placeholderOnFocus="+7 (___) ___-__-__" autocomplete="tel" />
    <TextArea name="message" label="Опишите задачу" class="contact-form__wide" />
    <FileField class="contact-form__wide" />
  </div>
  <div class="contact-form__submit">
    <button type="submit" class="btn contact-form__button btn-fill">
      <span data-send-label>Отправить заявку</span><span aria-hidden="true">→</span>
    </button>
    <div class="contact-form__legal">
      Отправляя заявку, вы соглашаетесь с
      <!-- TODO: страницы политики пока нет — разметка сохранена -->
      <span class="contact-form__policy">политикой обработки персональных данных</span>
    </div>
  </div>
</form>

<style>
  .contact-form {
    margin: 0;
    background: var(--color-bg-card-dark);
    padding: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .contact-form__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .contact-form__title {
    margin: 0;
    font: 700 clamp(44px, 4.6vw, 68px) / 0.92 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .contact-form__accent {
    color: var(--color-accent);
  }
  .contact-form__lead {
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-on-dark-72);
    max-width: var(--desc-max);
    text-wrap: pretty;
  }
  .contact-form__fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(max(220px, calc(50% - 6px)), 1fr));
    gap: var(--space-sm);
  }
:global(.contact-form__wide) {
    grid-column: 1 / -1;
  }
  .contact-form__submit {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-form__button {
    justify-content: space-between;
    background-image: var(--fill-light-to-accent);
    color: var(--color-white-pure);
    padding: 24px 28px;
  }
  .contact-form__button:hover {
    color: var(--color-text-primary);
  }
  .contact-form__legal {
    font-size: var(--fs-tag);
    line-height: var(--lh-body);
    color: var(--color-text-on-dark-50);
  }
  .contact-form__policy {
    color: var(--color-text-on-dark-80);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
