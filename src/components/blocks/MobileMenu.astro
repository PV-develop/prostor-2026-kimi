---
import SectionLabel from '../ui/SectionLabel.astro';
import { contacts, menuNav, menuNavExtra, menuServiceGroups } from '../../content/home';

const icon = (name: string) => {
  const paths: Record<string, string> = {
    telegram: '<path d="M3 10.5 20 4l-3.5 16-5-5-3 3 .5-6 8-5-10 4.5Z"/>',
    whatsapp:
      '<path d="M5 18 3 21l4-1a9 9 0 1 0-2-2Z"/><path d="m8 7 2 3-1 1c1 2 2 3 4 3l1-1 3 1c-1 4-6 3-9 0S5 8 8 7Z"/>',
    vk: '<path d="M3 7h3c0 4 2 6 3 7V7h3v4c2-1 3-3 4-4h4l-4 6c3 2 4 4 4 4h-4l-4-4v4H9C5 16 3 12 3 7Z"/>',
    youtube:
      '<rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m10 9 6 3-6 3Z"/>',
    dzen: '<path d="M12 2c0 8 2 10 10 10-8 0-10 2-10 10 0-8-2-10-10-10C10 12 12 10 12 2Z"/>',
  };
  const filled = name !== 'youtube';
  return `<svg viewBox="0 0 24 24" ${filled ? 'fill="currentColor"' : 'fill="none" stroke="currentColor" stroke-width="1.8"'} aria-hidden="true" class="mobile-menu__soc-icon">${paths[name]}</svg>`;
};

const socialKeys = ['telegram', 'whatsapp', 'vk', 'youtube', 'dzen'];
---

<div class="mobile-menu" data-menu id="mobile-menu" data-open="false" aria-hidden="true">
  <div class="mobile-menu__head" data-mh>
    <a href="#" class="mobile-menu__logo" aria-label="Простор">
      <img src="/images/logo/logo-black.svg" alt="" width="201" height="31" />
    </a>
    <a href={contacts.phone800Href} class="mobile-menu__phone">{contacts.phone800}</a>
    <button type="button" data-close-menu class="mobile-menu__close" aria-label="Закрыть меню">
      <span data-mhlabel>Закрыть</span><span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="mobile-menu__grid" data-mg>
    <nav class="mobile-menu__nav" data-mmain aria-label="Разделы сайта">
      {menuNav.map((item) => (
        <a href={item.href} class="mobile-menu__nav-link">
          <span class="mobile-menu__nav-num">{item.num}</span>
          {item.label}
        </a>
      ))}
      {/* TODO: пункты без страниц временно скрыты; вернуть, заменив href={null} на реальный адрес */}
      {menuNavExtra.map((item) => (
        <a class="mobile-menu__nav-link mobile-menu__nav-link--extra" data-mextra hidden>{item.label}</a>
      ))}
    </nav>
    <div class="mobile-menu__services" data-mservices>
      <div class="mobile-menu__services-title">
        <span class="tag-square"></span>Услуги
      </div>
      <div class="mobile-menu__services-grid" data-msnav>
        {menuServiceGroups.map((group) => (
          <details class="mobile-menu__group" data-mgrp open>
            <summary class="mobile-menu__group-summary">
              {group.title}
              <span class="mobile-menu__plus" data-mplus aria-hidden="true"></span>
            </summary>
            <div class="mobile-menu__group-items">
              {/* TODO: ссылки на страницы услуг пока отсутствуют — вернуть href при создании страниц */}
              {group.items.map((item) => (
                <a class="mobile-menu__service-link">{item}</a>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
    <div class="mobile-menu__aside" data-mc>
      {/* TODO: страницы пока нет — разметка сохранена, ссылка отключена до появления страницы */}
      <details class="mobile-menu__group mobile-menu__prices" hidden>
        <summary class="mobile-menu__aside-link">
          Цены<span class="mobile-menu__plus" aria-hidden="true">+</span>
        </summary>
        <div class="mobile-menu__group-items mobile-menu__prices-items">
          <a class="mobile-menu__service-link">SEO-продвижение ↗</a>
          <a class="mobile-menu__service-link">Контекстная реклама ↗</a>
          <a class="mobile-menu__service-link">Разработка сайтов ↗</a>
        </div>
      </details>
      {/* TODO: страницы нет — временно скрыто, разметка сохранена */}
      <a class="mobile-menu__aside-link" hidden>О компании <span aria-hidden="true">↗</span></a>
      <!-- TODO: страницы нет — временно скрыто, разметка сохранена -->
      <a class="mobile-menu__aside-link" hidden>Блог <span aria-hidden="true">↗</span></a>
      <div class="mobile-menu__contacts" data-mcontacts>
        <a href={contacts.emailHref} class="mobile-menu__email">
          {contacts.email} <span data-marrow aria-hidden="true">↗</span>
        </a>
        <a href={contacts.phone800Href} class="mobile-menu__phone-link" data-mphone>{contacts.phone800}</a>
      </div>
      <div class="mobile-menu__socials" data-msoc>
        {contacts.socials.map((s, i) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="mobile-menu__soc">
            <Fragment set:html={icon(socialKeys[i])} />
            {s.label}
          </a>
        ))}
      </div>
      <a href="#contacts" class="btn mobile-menu__cta" data-mcta>Обсудить задачу <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-menu);
    box-sizing: border-box;
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-text-on-light-22);
    max-height: 92svh;
    overflow: auto;
    padding: var(--space-lg) var(--space-page) 68px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-14px);
    pointer-events: none;
    transition:
      opacity var(--dur-base) ease,
      transform var(--dur-swipe) var(--ease-out),
      visibility 0s linear var(--dur-swipe);
  }
  .mobile-menu[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition:
      opacity var(--dur-slow) ease 0.05s,
      transform 0.55s var(--ease-out) 0.05s;
  }
  .mobile-menu__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-text-on-light-14);
  }
  .mobile-menu__logo {
    display: flex;
    height: 31px;
    align-items: center;
  }
  .mobile-menu__logo img {
    height: 31px;
    width: auto;
  }
  .mobile-menu__phone {
    justify-self: start;
    font: 700 clamp(28px, 3.2vw, 44px) / 1 var(--font-display);
    font-stretch: 25%;
    letter-spacing: 0.01em;
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  .mobile-menu__close {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-width: 124px;
    padding: 13px var(--space-lg);
    border: 1px solid var(--color-text-primary);
    color: var(--color-text-primary);
    font: 600 var(--fs-tag) / 1 var(--font-mono);
    letter-spacing: var(--ls-btn-sm);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background var(--dur-base),
      color var(--dur-base);
  }
  .mobile-menu__close:hover {
    background: var(--color-text-primary);
    color: var(--color-bg-page);
  }
  .mobile-menu__close > span:last-child {
    font: 400 18px / 1 var(--font-body);
  }
  .mobile-menu__grid {
    display: grid;
    grid-template-columns: 3fr 6fr 2.4fr;
    gap: var(--space-3xl);
    padding-top: 26px;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
    border-right: 1px solid var(--color-text-on-light-12);
    padding-right: 36px;
  }
  .mobile-menu__nav-link {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font: 700 var(--fs-menu-item) / 1.02 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    color: var(--color-text-primary);
    transition: color var(--dur-fast);
  }
  .mobile-menu__nav-link:hover {
    color: var(--color-accent);
  }
  .mobile-menu__nav-num {
    margin-top: 7px;
    font: 500 10px / 1 var(--font-mono);
    letter-spacing: var(--ls-mono);
    color: var(--color-accent);
  }
  .mobile-menu__services-title {
    margin-bottom: 22px;
    font: 500 13px / var(--lh-label) var(--font-body);
    color: var(--color-text-accent);
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }
  .mobile-menu__services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px 36px;
  }
  .mobile-menu__group {
    margin: 0;
  }
  .mobile-menu__group-summary {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 10px;
    margin-bottom: 6px;
    font: 700 24px / 1 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
    transition: color var(--dur-fast);
  }
  .mobile-menu__group-summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu__group-summary:hover {
    color: var(--color-accent);
  }
  /* Значок слева: «+» когда группа раскрыта, «−» когда свёрнута */
  .mobile-menu__plus {
    font: 400 22px / 1 var(--font-body);
    width: 14px;
    text-align: center;
    flex: none;
  }
  .mobile-menu__plus::before {
    content: '−';
  }
  .mobile-menu__group[open] > summary > .mobile-menu__plus::before {
    content: '+';
  }
  /* Отступ от заголовка группы до подпунктов */
  .mobile-menu__group[open] > .mobile-menu__group-summary {
    margin-bottom: 15px;
  }
  .mobile-menu__group-items {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .mobile-menu__service-link {
    font: 400 14px / 1.45 var(--font-body);
    color: var(--color-text-on-light-62);
    transition: color var(--dur-instant);
    cursor: pointer;
  }
  .mobile-menu__service-link:hover {
    color: var(--color-accent);
  }
  .mobile-menu__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .mobile-menu__prices {
    width: 100%;
  }
  .mobile-menu__aside-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font: 700 var(--fs-menu-item) / 1.02 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: color var(--dur-fast);
    list-style: none;
  }
  .mobile-menu__aside-link::-webkit-details-marker {
    display: none;
  }
  .mobile-menu__aside-link:hover {
    color: var(--color-accent);
  }
  .mobile-menu__aside-link > span[aria-hidden] {
    font: 400 20px / 1 var(--font-body);
  }
  .mobile-menu__prices-items {
    padding: 14px 0 2px;
  }
  .mobile-menu__contacts {
    display: contents;
  }
  .mobile-menu__email {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font: 500 14px / 1.4 var(--font-body);
    color: var(--color-text-primary);
    transition: color var(--dur-instant);
  }
  .mobile-menu__email:hover {
    color: var(--color-accent);
  }
  .mobile-menu__phone-link {
    display: none;
    font: 500 14px / 1.4 var(--font-body);
    color: var(--color-text-primary);
  }
  .mobile-menu__socials {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin-top: var(--space-sm);
  }
  .mobile-menu__soc {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 13px / 1.4 var(--font-body);
    color: var(--color-text-on-light-75);
    transition: color var(--dur-instant);
  }
  .mobile-menu__soc:hover {
    color: var(--color-accent);
  }
  .mobile-menu__soc-icon {
    width: 15px;
    height: 15px;
    flex: none;
  }
  .mobile-menu__cta {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    background: var(--color-accent);
    color: var(--color-text-primary-inverse);
    padding: var(--space-lg);
  }
  [hidden] {
    display: none !important;
  }
  /* Атрибут hidden должен побеждать display у компонентных классов */
  [hidden] {
    display: none !important;
  }
  /* На десктопе «дополнительные» пункты навигации скрыты */
  .mobile-menu__nav-link--extra {
    display: none;
  }
  .mobile-menu__plus[data-mplus] {
    display: none;
  }

  @media (max-width: 1100px) {
    .mobile-menu__grid {
      grid-template-columns: 1.3fr 1.6fr;
    }
    .mobile-menu__aside {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 30px;
    }
  }
  @media (max-width: 768px) {
    .mobile-menu {
      padding: 14px var(--space-page-mobile) 44px;
      max-height: 100svh;
    }
    .mobile-menu__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm);
      padding-bottom: 14px;
    }
    .mobile-menu__head > a[href^='tel'] {
      display: none;
    }
    .mobile-menu__close {
      order: 2;
      margin-left: auto;
      min-width: 0;
      border: 0;
      background: transparent;
      padding: 2px;
    }
    .mobile-menu__close > span:first-child {
      display: none;
    }
    .mobile-menu__close > span:last-child {
      font-size: 28px;
    }
    .mobile-menu__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-top: 18px;
    }
    .mobile-menu__nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl) var(--space-lg);
      border-right: 0;
      padding-right: 0;
      border-bottom: 1px solid var(--color-text-on-light-12);
      padding-bottom: 22px;
    }
    .mobile-menu__nav-link {
      font-size: 26px;
    }
    .mobile-menu__nav-num {
      display: none;
    }
    .mobile-menu__nav-link--extra {
      display: block;
    }
    .mobile-menu__services {
      border-bottom: 1px solid var(--color-text-on-light-12);
      padding-bottom: 22px;
    }
    .mobile-menu__services-grid {
      gap: 22px var(--space-xl);
    }
    .mobile-menu__group-summary {
      font-size: 20px;
      margin-bottom: 0;
    }
    .mobile-menu__group[open] > summary {
      margin-bottom: 15px;
    }
    .mobile-menu__plus[data-mplus] {
      display: inline;
    }
    .mobile-menu__aside {
      flex-direction: column;
      gap: 18px;
      align-items: stretch;
    }
    .mobile-menu__prices {
      display: none;
    }
    .mobile-menu__contacts {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-md);
      margin-top: 6px;
    }
    .mobile-menu__email {
      margin-top: 0;
    }
    [data-marrow] {
      display: none;
    }
    .mobile-menu__phone-link {
      display: block;
    }
    .mobile-menu__socials {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md) var(--space-sm);
      margin-top: 6px;
    }
    .mobile-menu__cta {
      display: flex;
      margin-top: var(--space-sm);
    }
  }
</style>
