---
import SectionLabel from '../ui/SectionLabel.astro';
import { trustMarquee } from '../../content/home';

const items = [...trustMarquee, ...trustMarquee];
---

<div class="trust" data-m="trust">
  <SectionLabel text="Нам доверяют" variant="h" tone="light" />
  <div class="trust__mask">
    <div class="trust__track">
      {items.map((item) => (
        <>
          <span>{item}</span>
          <span class="trust__dot" aria-hidden="true"></span>
        </>
      ))}
    </div>
  </div>
</div>

<style>
  .trust {
    position: relative;
    z-index: 4;
    margin: 0 var(--space-page);
    border-top: 1px solid var(--color-text-on-dark-14);
    padding: 22px 0 26px;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-col-gap);
  }
  .trust__mask {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .trust__track {
    display: flex;
    gap: 44px;
    align-items: center;
    width: max-content;
    animation: marq var(--dur-marquee) linear infinite;
    font: 700 30px / 1 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    color: var(--color-text-on-dark-55);
  }
  .trust__dot {
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    flex: none;
  }
  @media (max-width: 768px) {
    .trust {
      margin: 0 var(--space-page-mobile);
      grid-template-columns: minmax(0, 1fr);
      row-gap: 14px;
      padding: 18px 0 22px;
    }
  }
</style>
