---
interface Props {
  photo: string;
  name: string;
  role: string;
  since?: string;
  num: string;
}
const { photo, name, role, since, num } = Astro.props;
---

<div class="team-card" data-reveal data-team-card>
  <div class="team-card__photo">
    <img src={photo} alt={name} loading="lazy" />
    <span class="team-card__num">{num}</span>
  </div>
  <div class="team-card__caption">
    <div class="team-card__name">{name}</div>
    <div class="team-card__role">{role}</div>
    {since && <div class="team-card__since">{since}</div>}
  </div>
</div>

<style>
  .team-card {
    position: relative;
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .team-card__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-bg-photo);
    flex: none;
  }
  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .team-card__num {
    position: absolute;
    left: var(--space-lg);
    bottom: var(--space-lg);
    min-width: 44px;
    box-sizing: border-box;
    padding: 10px 12px;
    background: var(--color-accent);
    color: var(--color-text-primary-inverse);
    font: 500 var(--fs-label) / 1 var(--font-mono);
    text-align: center;
  }
  .team-card__caption {
    padding: var(--space-lg) 0 4px;
  }
  .team-card__name {
    font: 700 clamp(30px, 2.4vw, 44px) / 0.95 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
  }
  .team-card__role {
    font: 400 var(--fs-label) / var(--lh-label) var(--font-mono);
    margin-top: var(--space-sm);
  }
  .team-card__since {
    font: 400 var(--fs-label) / var(--lh-label) var(--font-mono);
    margin-top: var(--space-lg);
  }
  @media (max-width: 768px) {
    .team-card {
      padding: var(--space-sm);
    }
    .team-card__caption {
      padding: var(--space-md) 0 2px;
    }
    .team-card__name {
      font-size: 22px;
    }
    .team-card__role,
    .team-card__since {
      font-size: var(--fs-btn-sm);
      margin-top: 10px;
    }
    .team-card__num {
      left: 10px;
      bottom: 10px;
      min-width: 32px;
      padding: var(--space-xs);
      font-size: 10px;
    }
  }
</style>
