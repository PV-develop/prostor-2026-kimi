---
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'tel' | 'email';
  placeholderOnFocus?: string;
  autocomplete?: string;
  /** ink — поле на фоне формы #1A1A1A (CTA); dark — на фоне #0F0F0F (контактная форма) */
  tone?: 'ink' | 'dark';
  class?: string;
}
const { name, label, type = 'text', placeholderOnFocus = '', autocomplete, tone = 'ink', class: className = '' } = Astro.props;
---

<label class={`field field--${tone} ${className}`} data-field>
  <span class="field__label">{label}</span>
  <input
    class="field__input"
    type={type}
    name={name}
    autocomplete={autocomplete}
    data-float-input
    data-placeholder-on-focus={placeholderOnFocus}
  />
</label>

<style>
  .field {
    position: relative;
    display: block;
    cursor: text;
  }
  .field__label {
    position: absolute;
    left: 18px;
    top: 20px;
    font: 400 var(--fs-body) var(--font-body);
    color: var(--color-text-on-dark-55);
    pointer-events: none;
    transition:
      top var(--dur-fast),
      font-size var(--dur-fast);
  }
  .field__input {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    height: 60px;
    padding: 22px 18px 0;
    border: 1px solid var(--color-text-on-dark-22);
    color: var(--color-text-primary-inverse);
    font: 400 var(--fs-body) var(--font-body);
    transition: border-color var(--dur-base);
  }
  .field--ink .field__input {
    background: var(--color-bg-card-dark);
  }
  .field--dark .field__input {
    background: var(--color-bg-dark);
  }
  .field:focus-within .field__input {
    border-color: var(--color-text-primary-inverse);
  }
  .field:focus-within .field__label,
  .field.is-filled .field__label {
    top: 10px;
    font-size: var(--fs-tag);
  }
</style>
