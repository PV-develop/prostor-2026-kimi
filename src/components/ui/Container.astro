---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class={`container ${className}`}><slot /></Tag>

<style>
  .container {
    padding-inline: var(--space-page);
  }
  @media (max-width: 768px) {
    .container {
      padding-inline: var(--space-page-mobile);
    }
  }
</style>
